        "id": {
          "type": "string",
          "description": "记录的稳定编号"
        },
        "category": {
          "type": "string",
          "description": "ordinary、student或assisted"
        },
        "valid_from": {
          "type": "string",
          "description": "资质生效日"
        },
        "valid_to": {
          "type": "string",
          "description": "资质失效日"
        },
        "tokens": {
          "type": "array",
          "description": "本用途允许链接的票卡键"
        }
      },
      "references": {}
    },
    "fare_contracts": {
